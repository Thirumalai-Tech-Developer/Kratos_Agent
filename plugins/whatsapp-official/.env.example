# Private configuration is stored in .kratos/plugins/whatsapp-official/.env
WHATSAPP_BRIDGE_ENABLED=false
ROUTING_BASE_URL=http://127.0.0.1:28080
ROUTING_API_KEY=
# International phone digits without +, separated by commas.
WHATSAPP_ALLOWED_PHONES=
# false = direct chat; true = allow the Kratos agent to execute tools.
WHATSAPP_AGENT_MODE=false
