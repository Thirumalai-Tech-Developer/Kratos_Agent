# Kratos Agent configuration template
# Copy this file to .env and set KRATOS_MODEL to the exact ID served by your
# local Kratos gateway. The agent will not choose another model if it is down.

# Required reasoning model configuration
KRATOS_BASE_URL=http://127.0.0.1:20128/v1
KRATOS_MODEL=
KRATOS_API_KEY=
KRATOS_TIMEOUT=60
KRATOS_MAX_RETRIES=2

# Local MCP capabilities
KRATOS_COMPUTER_USE_MCP=true
KRATOS_OPENPETS_MCP=true

# Optional Gemini speech rendering. Speech recognition stays local, and only
# text between [[speak]]...[[/speak]] is sent for speech output.
KRATOS_LIVE_ENABLED=false
KRATOS_LIVE_MODEL=gemini-3.8-live
KRATOS_LIVE_VOICE=Zephyr
GEMINI_API_KEY=

# Optional local web interface
HOST=127.0.0.1
PORT=7860
AGENT_PASSWORD=change-this-before-exposing-the-web-interface
