# Kratos Agent - Environment Configuration Template
# Copy this file to .env and configure your secrets:
#   cp .env.example .env

# LLM Gateway & Authentication
OMNI_KEY=your_omniroute_or_openai_api_key_here
BRAIN_BASE_URL=https://api.omniroute.ai/v1
CHAT_ENDPOINT=https://api.omniroute.ai/v1/chat/completions
MODEL_ENDPOINT=https://api.omniroute.ai/v1/models

# Models Configuration
BRAIN_MODEL=antigravity/gemini-3.7-flash-high
NORMAL_MODE_MODEL=ds-web/deepseek-v4-flash-think
AGENT_MODEL=antigravity/gemini-3.7-flash-high

# Web Server & Security
PORT=7860
HOST=127.0.0.1
AGENT_PASSWORD=change_this_to_a_secure_passcode
KRATOS_ALLOW_DYNAMIC_PLUGINS=false

# Gemini Live & Multimodal (Optional)
GEMINI_API_KEY=

# Engine Performance & Timeouts
BRAIN_TIMEOUT=120
BRAIN_MAX_RETRIES=2
KRATOS_PARALLEL_EXECUTION=true
KRATOS_MAX_PARALLEL_WORKERS=8

# Headroom Context Compaction (Optional)
HEADROOM_ENABLED=false
HEADROOM_MODEL=gpt-4o
HEADROOM_PROXY_PORT=8000
